# Miscellaneous
*.class
*.log
# 持续迭代的门禁证据是台账的一部分，必须随仓库走（iter3 复审 F-5）
!docs/continuous-iteration/evidence/*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/dist/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Git worktrees (isolated execution workspaces)
.worktrees/

# flutter gen-l10n output (regenerated by pub get, not committed)
lib/l10n/*.dart

# Flutter 工具本地状态
.flutter_tool_state

# 本地逆向/构建辅助工具（脚本产物与安装包不入库）；tools/iteration 是版本化的流程工具链（iter3 复审 F-2）
tools/*
!tools/iteration/
artifacts/

# CI 的临时 SBOM（部分清单，仅用于 PR 侧依赖报告）
sbom-ci.json

# 本地材料：官方产物、交接文档、扫描工具状态，一律不入库
reference/
交接文档.md
.mimosa/

android/.gradle/
android/.kotlin/
android/local.properties
android/key.properties
**/*.jks
**/*.keystore
**/*.p12
.flutter-plugins
*.apk
*.ipa
*.so.tmp
